<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  DevDesk style rules. Kept deliberately small: spacing and line breaks are the
  formatter's job (Spotless + palantir), so this file only catches sloppy code.
  Any rule broken here fails ./gradlew build.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- import java.util.*; hides what a file really uses. -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- catch (Exception e) {} silently hides failures. DevDesk must fail loudly. -->
        <module name="EmptyCatchBlock"/>

        <!-- Every public class says its job in one sentence (CLAUDE.md, Java style). -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
    </module>
</module>
